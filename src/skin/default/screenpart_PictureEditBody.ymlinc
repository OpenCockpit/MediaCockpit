# What the screens of the picture editor have in common: the place of the picture, the picture, the line in the header and the toast.
# The screen puts the picture into the body, in its own size.
- widget:
    name: "body"
    position: "$window_full_body_x,$window_full_body_y"
    size: "$window_full_body_width,$window_full_body_height"
    transparent: "1"
    zPosition: "-5"
- widget:
    name: "preview"
    position: "$window_full_body_x,$window_full_body_y"
    size: "$window_full_body_width,$window_full_body_height"
    zPosition: "31"
- widget:
    font: "$md_body_small"
    foregroundColor: "md_on_surface"
    halign: "right"
    name: "osd_info"
    noWrap: "1"
    position: "760,17"
    size: "950,36"
    transparent: "1"
    valign: "center"
    zPosition: "40"
- widget:
    backgroundColor: "md_scrim"
    cornerRadius: "$radius_window"
    font: "$md_label_large"
    foregroundColor: "md_on_surface"
    halign: "center"
    name: "toast"
    position: "556,68"
    size: "800,52"
    valign: "center"
    zPosition: "50"
