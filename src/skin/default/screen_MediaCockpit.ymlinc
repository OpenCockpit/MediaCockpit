screen:
  backgroundColor: "md_transparent"
  name: "MediaCockpit"
  position: "fill"
  resolution: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_full_width,$window_full_height"
        window_inset_x: "$window_full_body_x"
    - widget:
        font: "$md_body_small"
        name: "osd_info"
        noWrap: "1"
        position: "280,18"
        size: "1430,34"
        transparent: "1"
        valign: "center"
        zPosition: "21"
    # a short message (Toast.py), over the tiles; wide and two lines high: some messages are long
    - widget:
        backgroundColor: "md_scrim"
        cornerRadius: "$radius_window"
        font: "$md_label_large"
        foregroundColor: "md_on_surface"
        halign: "center"
        name: "toast"
        position: "306,68"
        size: "1300,96"
        valign: "center"
        zPosition: "50"
    - xmlinc:
        file: "screenpart_MediaCockpitBody.ymlinc"
        position: "$window_full_body_x,$window_full_body_y"
        size: "$window_full_body_width,$window_full_body_height"
