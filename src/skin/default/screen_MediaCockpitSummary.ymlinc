screen:
  name: "MediaCockpitSummary"
  position: "fill"
  resolution: "396,240"
  children:
    - xmlinc:
        file: "screenpart_LCDBackground.ymlinc"
        imagepath: "~/../images"
    - widget:
        font: "$F_bigger"
        foregroundColor: "FdLcdTitleForeground"
        halign: "center"
        position: "0,0"
        render: "Label"
        size: "$screen_width-4,75"
        source: "parent.lcd_title"
        transparent: "1"
        valign: "top"
    - widget:
        font: "$F_bigger"
        halign: "center"
        position: "0,75"
        render: "Label"
        size: "$screen_width-4,$screen_height-75"
        source: "parent.lcd_info"
        transparent: "1"
        valign: "center"
