screen:
  backgroundColor: "md_transparent"
  name: "Slideshow"
  position: "fill"
  resolution: "1920,1080"
  children:
    # The pictures. A screen with position fill shifts everything by 4,4 (the window is placed at 4,4): -4,-4 puts them on the whole screen.
    # They are above every part of the full size window: while a slideshow runs they cover all of it, the screen is the picture.
    # With the buttons shown the picture is smaller (it is placed in "body") and the header with the clock and the footer with
    # the keys are visible, as in the other screens.
    - widget:
        name: "picture_background"
        position: "-4,-4"
        size: "1920,1080"
        zPosition: "30"
    - widget:
        name: "picture"
        position: "-4,-4"
        scaleFlags: "scaleCenter"
        size: "1920,1080"
        zPosition: "31"
    - widget:
        name: "image"
        position: "-4,-4"
        size: "1920,1080"
        zPosition: "32"
    - xmlinc:
        file: "screenpart_Window.ymlinc"
        position: "center"
        size: "$window_full_width,$window_full_height"
        window_inset_x: "$window_full_body_x"
    - widget:
        font: "$md_body_small"
        foregroundColor: "md_on_surface"
        name: "osd_info"
        noWrap: "1"
        position: "280,18"
        size: "1430,34"
        transparent: "1"
        valign: "center"
        zPosition: "40"
    # the place of the picture while the buttons are shown (read by the screen, nothing is drawn)
    - widget:
        name: "body"
        position: "$window_full_body_x,$window_full_body_y"
        size: "$window_full_body_width,$window_full_body_height"
        transparent: "1"
        zPosition: "-5"
    - widget:
        backgroundColor: "md_scrim"
        cornerRadius: "$radius_window"
        font: "$md_label_large"
        foregroundColor: "md_on_surface"
        halign: "center"
        name: "toast"
        position: "556,68"
        size: "800,52"
        valign: "center"
        zPosition: "50"
