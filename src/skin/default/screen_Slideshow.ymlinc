screen:
  backgroundColor: "md_surface"
  name: "Slideshow"
  position: "0,0"
  size: "1920,1080"
  children:
    - widget:
        name: "image"
        position: "0,0"
        size: "1920,1080"
        zPosition: "3"
    - widget:
        name: "picture_background"
        position: "0,0"
        size: "1920,1080"
        zPosition: "1"
    - widget:
        name: "picture"
        position: "0,0"
        scaleFlags: "scaleCenter"
        size: "1920,1080"
        zPosition: "2"
    - widget:
        backgroundColor: "md_scrim"
        cornerRadius: "$radius_window"
        name: "bar_background"
        position: "20,12"
        size: "$screen_width-40,44"
        zPosition: "5"
    - widget:
        font: "$md_label_large"
        foregroundColor: "md_on_surface"
        halign: "left"
        name: "osd_info"
        noWrap: "1"
        position: "44,12"
        size: "$screen_width-88,44"
        transparent: "1"
        valign: "center"
        zPosition: "6"
    - eLabel:
        backgroundColor: "md_surface_container_high"
        cornerRadius: "$radius_window"
        position: "20,$screen_height-58"
        size: "$screen_width-40,48"
        zPosition: "-1"
    - widget:
        backgroundColor: "md_scrim"
        cornerRadius: "$radius_window"
        font: "$md_label_large"
        foregroundColor: "md_on_surface"
        halign: "center"
        name: "toast"
        position: "560,72"
        size: "800,52"
        valign: "center"
        zPosition: "8"
    - xmlinc:
        file: "screenpart_WindowFooter.ymlinc"
        buttons_bar_z: "0"
        position: "44,$screen_height-52"
        size: "$screen_width-88,36"
